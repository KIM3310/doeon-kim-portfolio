# Optional lane-specific hosted checkout URLs. Leave blank to fall back to the
# private Cloudflare D1 inquiry form. Quote-only lanes always use that route.
# Any HTTPS hosted provider can be used, including Lemon Squeezy or Polar.
INQUIRY_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
VITE_CHECKOUT_ARCHITECTURE_SCOPE_SPRINT_URL=
VITE_CHECKOUT_AGENT_RELIABILITY_AUDIT_URL=
VITE_CHECKOUT_PRIVATE_AI_READINESS_SPRINT_URL=
VITE_CHECKOUT_INCIDENT_OPERATIONS_EXERCISE_URL=
VITE_CHECKOUT_SECURE_WORKFLOW_PILOT_URL=
VITE_CHECKOUT_INDUSTRIAL_VALIDATION_DISCOVERY_URL=
VITE_CHECKOUT_CONSUMER_PROTOTYPE_CUSTOMIZATION_URL=
