{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kim3310-portfolio-inquiry-retention",
  "main": "./workers/inquiry-retention.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "portfolio-leads-prod",
      "database_id": "0e04a267-8258-4687-8975-229d0db4a1c0"
    }
  ]
}
